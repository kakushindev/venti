{
  "name": "venti",
  "version": "1.0.0",
  "description": "A Venti the bard— A Discord music bot with Lavalink featured with an awesome new thing on Discord.",
  "keywords": [
    "js",
    "typescript"
  ],
  "homepage": "https://kakushin.dev/",
  "bugs": {
    "url": "https://github.com/kakushindev/venti/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakushindev/venti.git"
  },
  "license": "AGPL-3.0",
  "author": "Kakushin Devs <hello@kakushin.dev>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run lint && pnpm run compile",
    "compile": "pnpm prisma:generate && tsc --build tsconfig.json",
    "lint": "pnpm run prisma:generate && eslint .",
    "lint:fix": "pnpm run lint --fix",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:push": "prisma db push",
    "start": "node --experimental-specifier-resolution=node dist/main",
    "start:dev": "rimraf ./dist && pnpm run compile && node --experimental-specifier-resolution=node --no-warnings dist/main"
  },
  "dependencies": {
    "@discordjs/builders": "^1.15.0",
    "@lavalink/encoding": "^0.1.2",
    "@prisma/client": "^6.19.3",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.1",
    "@sapphire/plugin-editable-commands": "^4.0.4",
    "@sapphire/result": "^2.8.0",
    "@sapphire/utilities": "^3.18.3",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.28.0",
    "dotenv": "^16.6.1",
    "got": "^12.6.1",
    "lavalink-api-types": "^2.0.2",
    "pino-pretty": "^9.4.1",
    "pretty-ms": "^8.0.0",
    "shoukaku": "^4.3.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@hazmi35/eslint-config": "^15.2.2",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=7.24.2"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
